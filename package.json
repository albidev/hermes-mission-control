{
  "name": "hermes-mission-control",
  "private": false,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "description": "Standalone operational dashboard for Hermes with live telemetry and zero core dependencies.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:telemetry": "./scripts/run-local-telemetry.sh",
    "dev:full": "concurrently -k -n telemetry,vite -c blue,green \"pnpm dev:telemetry\" \"pnpm dev\"",
    "build": "vite build",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:vite-config": "node tests/vite-config.test.mjs",
    "test:chat": "node --experimental-strip-types tests/chat-protocol.test.ts && node --experimental-strip-types tests/chat-interactions.test.ts",
    "test:ui": "node --experimental-strip-types tests/chat-ui-contract.test.ts",
    "test:mobile-route-layout": "node tests/mobile-route-layout-contract.test.mjs",
    "test:provider-usage-ui": "node tests/provider-usage-ui-contract.test.mjs",
    "test:system-health-ui": "node tests/system-health-ui-contract.test.mjs",
    "test:smoke": "bash scripts/smoke-test-telemetry.sh",
    "check:paths": "bash scripts/check-documented-paths.sh",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "^6.30.3",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "tldraw": "5.3.2",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.2",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
