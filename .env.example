# Telemetry sidecar token (required)
# Generate: openssl rand -base64 32
MISSION_CONTROL_TOKEN=your_token_here

# Provider-usage visibility (optional, local allowlist; unset shows all)
# MISSION_CONTROL_USAGE_PROVIDERS=codex,ollama,openrouter,nous

# Vite dev server allowed hosts (comma separated Tailscale/local IPs)
MISSION_CONTROL_DEV_HOSTS=100.84.148.17,192.168.1.63

# Frontend API base path (keep relative for Tailscale/proxy compatibility)
VITE_MISSION_CONTROL_LOCAL_API_BASE_URL=/api/local

# Hermes dashboard API endpoint shared by the launcher and Vite proxy.
# Empty values use the defaults 127.0.0.1:9119.
MISSION_CONTROL_DASHBOARD_HOST=127.0.0.1
MISSION_CONTROL_DASHBOARD_PORT=9119
# Optional explicit Vite proxy override; takes precedence over host/port.
# HERMES_DASHBOARD_URL=http://127.0.0.1:9119

# Telemetry server bind address (canonical names)
# Legacy aliases TELEMETRY_BIND_HOST / TELEMETRY_BIND_PORT are still honored,
# but the MISSION_CONTROL_LOCAL_TELEMETRY_* names below take precedence when
# both are set.
#
# SECURITY: the default is loopback (127.0.0.1) — Mission Control is a local
# operator dashboard. Set 0.0.0.0 ONLY when you explicitly want LAN/Tailscale
# exposure (e.g. accessing the dashboard from other devices).
MISSION_CONTROL_LOCAL_TELEMETRY_HOST=127.0.0.1
MISSION_CONTROL_LOCAL_TELEMETRY_PORT=8765

# CORS allow-list (optional). When set, the telemetry server answers browser
# cross-origin requests ONLY for this exact origin. Leave unset to mirror the
# incoming Origin (dev mode, convenient for Tailscale/LAN). Example for
# Tailscale access via the Vite dev server:
#   MISSION_CONTROL_ALLOWED_ORIGIN=http://100.84.148.17:5174
# MISSION_CONTROL_ALLOWED_ORIGIN=

# Knowledge vault root (optional). The telemetry server scans this directory
# for Markdown notes to surface in the Knowledge page. When unset, the
# platform default is used: ~/Documents/Hermes on macOS, ~/wiki on Linux.
# Legacy alias: HERMES_OBSIDIAN_VAULT (MISSION_CONTROL_VAULT_PATH wins).
MISSION_CONTROL_VAULT_PATH=

# Web Push (optional). Requires the optional packages first:
#   python3 -m pip install -r server/requirements-push.txt
# Then generate a VAPID keypair, e.g. via pywebpush:
#   python3 -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); ..."
# The public key is served to the client for pushManager.subscribe(); the
# private key signs the Web Push Protocol requests. Push is enabled only when
# the two keys AND MISSION_CONTROL_VAPID_CONTACT below are all set — otherwise
# it degrades to "disabled" with a precise reason on /health.
MISSION_CONTROL_VAPID_PUBLIC_KEY=
MISSION_CONTROL_VAPID_PRIVATE_KEY=
# Email or URL identifying you as the push sender (required by push services).
# REQUIRED when push is enabled.
MISSION_CONTROL_VAPID_CONTACT=
