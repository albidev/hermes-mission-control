[Unit]
Description=Hermes Mission Control telemetry server (port 8765)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/hermes-mission-control
EnvironmentFile=-%h/Projects/hermes-mission-control/.env
Environment=PYTHONPATH=%h/.hermes/hermes-agent
ExecStart=%h/.hermes/hermes-agent/venv/bin/python %h/Projects/hermes-mission-control/server/local_telemetry_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
