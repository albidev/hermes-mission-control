[Unit]
Description=Hermes Mission Control dashboard API (port 9119)
# Hermes core dashboard backend. No ordering dependency on the rest of the
# stack — it is the first service to start.
After=network.target
Wants=network.target

[Service]
Type=simple
# Paths shown are the default install; adjust for your checkout/core.
WorkingDirectory=%h/.hermes/hermes-agent
EnvironmentFile=-%h/Projects/hermes-mission-control/.env
ExecStart=%h/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main dashboard --host 127.0.0.1 --port 9119 --no-open

# Restart on unexpected exit (crashes, OOM), but bound the restart rate so a
# permanently broken dependency fails the unit visibly instead of spinning.
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=5min
StartLimitBurst=10

[Install]
WantedBy=mission-control.target
