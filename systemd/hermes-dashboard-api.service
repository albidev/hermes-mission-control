[Unit]
Description=Hermes Mission Control dashboard API (port 9119)
After=network.target

[Service]
Type=simple
# Paths shown are the default install; adjust for your checkout/core.
WorkingDirectory=%h/.hermes/hermes-agent
EnvironmentFile=-%h/Projects/hermes-mission-control/.env
ExecStart=%h/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main dashboard --host 127.0.0.1 --port 9119 --no-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
