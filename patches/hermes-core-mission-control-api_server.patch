+def _resolve_knowledge_source_path(source_path: str) -> Path:
+    raw = (source_path or "").strip()
+    if not raw:
+        raise ValueError("source_path is required")
+
+    expanded = Path(raw.replace("~", str(Path.home()), 1)).expanduser().resolve(strict=False)
+    hermes_home = (Path.home() / ".hermes").resolve(strict=False)
+    vault = Path(os.getenv("OBSIDIAN_VAULT_PATH") or (Path.home() / "Documents" / "Hermes")).resolve(strict=False)
+    allowed_roots = [hermes_home, vault]
+
+    if not any(expanded == root or root in expanded.parents for root in allowed_roots):
+        raise ValueError("source_path is outside allowed roots")
+    if not expanded.is_file():
+        raise FileNotFoundError("Knowledge file not found")
+
+    return expanded
+
