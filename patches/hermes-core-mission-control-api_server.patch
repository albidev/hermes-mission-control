+def _build_mission_control_snapshot() -> Dict[str, Any]:
+    from gateway.status import get_running_pid, read_runtime_status
+    from hermes_state import SessionDB
+
+    runtime = read_runtime_status() or {}
+    gateway_state = str(runtime.get("gateway_state") or "unknown").lower()
+    running_pid = get_running_pid()
+
+    if gateway_state == "running" and running_pid is not None:
+        backend_health = "healthy"
+    elif gateway_state in ("starting", "unknown") and running_pid is not None:
+        backend_health = "degraded"
+    elif gateway_state in ("stopped", "startup_failed"):
+        backend_health = "offline"
+    else:
+        backend_health = "degraded" if running_pid is not None else "offline"
+
+    session_db = SessionDB()
+    active_session_model = ""
+    try:
+        total_sessions = session_db.session_count()
+        total_messages = session_db.message_count()
+        start_of_day = datetime.now(timezone.utc).replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
+        with session_db._lock:
+            cursor = session_db._conn.execute(
+                "SELECT COALESCE(SUM(tool_call_count), 0) FROM sessions WHERE started_at >= ?",
+                (start_of_day,),
+            )
+            tool_calls_today = int(cursor.fetchone()[0] or 0)
+
+        recent_sessions = session_db.list_sessions_rich(limit=40)
+        active_cutoff = time.time() - (30 * 60)
+        active_agents = sum(
+            1
+            for session in recent_sessions
+            if session.get("ended_at") is None and float(session.get("last_active") or 0) >= active_cutoff
+        )
+
+        valid_model_sessions = [
+            session
+            for session in recent_sessions
+            if str(session.get("model") or "").strip() and str(session.get("model") or "").strip().lower() != "unknown"
+        ]
+
+        # Source of truth: most recent OPEN session from the sessions table.
+        # This captures freshly started sessions even before list_sessions_rich()
+        # surfaces them with message-derived activity fields.
+        with session_db._lock:
+            cursor = session_db._conn.execute(
+                """
+                SELECT model
+                FROM sessions
+                WHERE ended_at IS NULL
+                  AND model IS NOT NULL
+                  AND TRIM(model) != ''
+                  AND LOWER(TRIM(model)) != 'unknown'
+                ORDER BY started_at DESC
+                LIMIT 1
+                """
+            )
+            row = cursor.fetchone()
+        if row and row[0]:
+            active_session_model = str(row[0]).strip()
+
+        # Fallback: infer from rich sessions if no open-session model is available.
+        if not active_session_model and valid_model_sessions:
+            best_session = max(
+                valid_model_sessions,
+                key=lambda session: (
+                    1 if session.get("ended_at") is None else 0,
+                    float(session.get("last_active") or session.get("started_at") or 0),
+                ),
+            )
+            active_session_model = str(best_session.get("model") or "").strip()
+    finally:
+        session_db.close()
+
+    try:
+        from cron.jobs import list_jobs as _cron_list
+
+        queued_jobs = len(_cron_list(include_disabled=False))
+    except Exception:
+        queued_jobs = 0
+
+    knowledge = _load_knowledge_sharing_note()
+    machine = _collect_machine_status()
+
+    resolved_gateway_model = ""
+    try:
+        from gateway.run import _resolve_gateway_model
+
+        resolved_gateway_model = str(_resolve_gateway_model() or "").strip()
+    except Exception:
+        resolved_gateway_model = ""
+
+    routing_model = resolved_gateway_model or os.getenv("HERMES_MODEL") or os.getenv("HERMES_INFERENCE_MODEL") or "gpt-5.4-mini"
+
+    # "activeModel" in Mission Control should represent the currently active runtime/session model,
+    # not the gateway default routing target.
+    if active_session_model:
+        active_model = active_session_model
+    else:
+        active_model = routing_model
+
+    fallback_model = os.getenv("HERMES_FALLBACK_MODEL") or "minimax-m2.7 @ localhost:8787"
+
+    recent_signals = [
+        {
+            "label": "Gateway",
+            "detail": f"{gateway_state.replace('_', ' ')} • pid {running_pid}" if running_pid is not None else f"{gateway_state.replace('_', ' ')} • no live pid",
+            "tone": "good" if backend_health == "healthy" else "warn" if backend_health == "degraded" else "bad",
+        },
+        {
+            "label": "Sessions",
+            "detail": f"{active_agents} active, {total_sessions} total, {total_messages} messages tracked.",
+            "tone": "good" if active_agents else "warn",
+        },
+        {
+            "label": "Fallback",
+            "detail": f"{fallback_model} is standing by for real provider failures.",
+            "tone": "good",
+        },
+        {
+            "label": "Knowledge vault",
+            "detail": knowledge["excerpt"],
+            "tone": "good" if knowledge["available"] else "warn",
+        },
+        {
+            "label": "Machine",
+            "detail": machine["summary"],
+            "tone": "good" if machine["health"] == "healthy" else "warn",
+        },
+    ]
+
+    return {
+        "backendHealth": backend_health,
+        "activeModel": active_model,
+        "fallbackModel": fallback_model,
+        "gatewayStatus": gateway_state,
+        "activeAgents": active_agents,
+        "queuedJobs": queued_jobs,
+        "toolCallsToday": tool_calls_today,
+        "recentSignals": recent_signals,
+        "knowledgeSharing": knowledge,
+        "machine": machine,
+    }
+
+
