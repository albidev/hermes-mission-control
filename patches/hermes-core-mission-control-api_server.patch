+    async def _handle_mission_control_config(self, request: "web.Request") -> "web.Response":
+        """GET/PUT /api/mission-control/config — read/write ~/.hermes/config.yaml safely."""
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+
+        headers = {"Cache-Control": "no-store"}
+
+        if request.method == "GET":
+            try:
+                return web.json_response({"success": True, **_read_config_snapshot()}, headers=headers)
+            except Exception as e:
+                logger.error("[%s] Failed to read Mission Control config: %s", self.name, e, exc_info=True)
+                return web.json_response(
+                    _openai_error(f"Internal server error: {e}", err_type="server_error"),
+                    status=500,
+                    headers=headers,
+                )
+
+        try:
+            body = await request.json()
+        except Exception:
+            return web.json_response(_openai_error("Invalid JSON in request body", code="invalid_json"), status=400, headers=headers)
+
+        if not isinstance(body, dict):
+            return web.json_response(_openai_error("Request body must be a JSON object.", code="invalid_request_body"), status=400, headers=headers)
+
+        content = body.get("content")
+        expected_hash = body.get("expectedHash") or body.get("hash") or body.get("version")
+        if not isinstance(content, str):
+            return web.json_response(_openai_error("Missing or invalid 'content' field.", param="content", code="invalid_content"), status=400, headers=headers)
+        if not isinstance(expected_hash, str) or not expected_hash.strip():
+            return web.json_response(_openai_error("Missing matching config hash/version.", param="expectedHash", code="missing_hash_guard"), status=400, headers=headers)
+
+        path = _config_path()
+        current_snapshot = _read_config_snapshot()
+        if expected_hash.strip() != current_snapshot["hash"]:
+            return web.json_response(
+                _openai_error(
+                    "Config changed on disk. Reload before saving your edits.",
+                    code="hash_mismatch",
+                ),
+                status=409,
+                headers={**headers, "X-Current-Hash": current_snapshot["hash"]},
+            )
+
+        try:
+            parsed = _parse_config_yaml(content)
+        except Exception as e:
+            return web.json_response(
+                _openai_error(f"Invalid YAML: {e}", code="invalid_yaml"),
+                status=400,
+                headers=headers,
+            )
+
+        backup_path = None
+        if path.exists():
+            stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+            backup_path = path.with_name(f"{path.name}.bak-{stamp}-{current_snapshot['hash'][:12]}")
+            try:
+                shutil.copy2(path, backup_path)
+            except Exception as e:
+                logger.error("[%s] Failed to create config backup: %s", self.name, e, exc_info=True)
+                return web.json_response(
+                    _openai_error(f"Failed to create config backup: {e}", code="backup_failed"),
+                    status=500,
+                    headers=headers,
+                )
+
+        try:
+            _atomic_write_text(path, content)
+        except Exception as e:
+            logger.error("[%s] Failed to write config.yaml: %s", self.name, e, exc_info=True)
+            return web.json_response(
+                _openai_error(f"Failed to write config: {e}", code="write_failed"),
+                status=500,
+                headers=headers,
+            )
+
+        updated_snapshot = _read_config_snapshot()
+        return web.json_response(
+            {
+                "success": True,
+                "path": updated_snapshot["path"],
+                "content": updated_snapshot["content"],
+                "config": parsed,
+                "hash": updated_snapshot["hash"],
+                "version": updated_snapshot["hash"],
+                "updatedAt": updated_snapshot["updatedAt"],
+                "backupPath": str(backup_path) if backup_path else None,
+            },
+            headers=headers,
+        )
