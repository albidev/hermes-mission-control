+    async def _handle_mission_control_agents_trace_stream(self, request: "web.Request") -> "web.StreamResponse":
+        """GET /api/mission-control/agents/trace/stream — SSE stream for live trace updates."""
+        auth_err = self._check_auth_with_query_fallback(request)
+        if auth_err:
+            return auth_err
+
+        session_id = (request.query.get("session_id") or "").strip() or None
+        try:
+            limit_raw = request.query.get("limit", "300")
+            parsed_limit = int(limit_raw)
+            limit = 0 if parsed_limit <= 0 else max(50, min(1000, parsed_limit))
+        except Exception:
+            limit = 300
+
+        try:
+            interval_raw = request.query.get("interval", "1.5")
+            interval = max(0.8, min(10.0, float(interval_raw)))
+        except Exception:
+            interval = 1.5
+
+        stream = web.StreamResponse(
+            status=200,
+            reason="OK",
+            headers={
+                "Content-Type": "text/event-stream",
+                "Cache-Control": "no-cache, no-store, must-revalidate",
+                "Connection": "keep-alive",
+                "X-Accel-Buffering": "no",
+            },
+        )
+        await stream.prepare(request)
+
+        async def _send_event(payload: Dict[str, Any], event: str = "trace") -> None:
+            body = json.dumps(payload, ensure_ascii=False)
+            await stream.write(f"event: {event}\n".encode("utf-8"))
+            await stream.write(f"data: {body}\n\n".encode("utf-8"))
+
+        try:
+            await stream.write(b": mission-control-agents-trace\n\n")
+            while True:
+                payload = _build_mission_control_agent_trace_payload(session_id=session_id, limit=limit)
+                await _send_event(payload)
+                await asyncio.sleep(interval)
+        except (asyncio.CancelledError, ConnectionResetError, BrokenPipeError):
+            pass
+        except Exception as e:
+            logger.error("[%s] Agents trace stream failed: %s", self.name, e, exc_info=True)
+            try:
+                await _send_event({"success": False, "error": str(e)}, event="error")
+            except Exception:
+                pass
+        finally:
+            try:
+                await stream.write_eof()
+            except Exception:
+                pass
+
+        return stream
+
