+    async def _handle_mission_control_agents_trace(self, request: "web.Request") -> "web.Response":
+        """GET /api/mission-control/agents/trace — event trace timeline + DAG payload."""
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+
+        headers = {"Cache-Control": "no-store"}
+        session_id = (request.query.get("session_id") or "").strip() or None
+
+        try:
+            limit_raw = request.query.get("limit", "300")
+            parsed_limit = int(limit_raw)
+            limit = 0 if parsed_limit <= 0 else max(50, min(1000, parsed_limit))
+        except Exception:
+            limit = 300
+
+        try:
+            payload = _build_mission_control_agent_trace_payload(session_id=session_id, limit=limit)
+            return web.json_response(payload, headers=headers)
+        except KeyError:
+            return web.json_response(
