+def _collect_machine_status() -> Dict[str, Any]:
+    host = py_platform.node() or os.getenv("HOSTNAME") or "unknown"
+    platform_name = py_platform.system() or "unknown"
+    platform_release = py_platform.release() or ""
+    platform_version = py_platform.version() or ""
+    cpu_cores = os.cpu_count() or 1
+
+    load_average = {"one": None, "five": None, "fifteen": None, "perCore": None}
+    try:
+        one, five, fifteen = os.getloadavg()
+        load_average = {
+            "one": round(float(one), 2),
+            "five": round(float(five), 2),
+            "fifteen": round(float(fifteen), 2),
+            "perCore": round(float(one) / cpu_cores, 3) if cpu_cores else None,
+        }
+    except (AttributeError, OSError, ValueError):
+        pass
+
+    disk = shutil.disk_usage(Path.home())
+    disk_used_percent = round((disk.used / disk.total) * 100, 1) if disk.total else None
+
+    cpu_usage_percent = None
+    ram_usage_percent = None
+    ram_usage_gb = None
+    ram_available_gb = None
+    ram_total_gb = None
+    process_memory_mb = None
+
+    if psutil is not None:
+        try:
+            cpu_usage_percent = round(float(psutil.cpu_percent(interval=None)), 1)
+        except Exception:
+            cpu_usage_percent = None
+        try:
+            vm = psutil.virtual_memory()
+            ram_usage_percent = round(float(vm.percent), 1)
+            ram_usage_gb = _format_bytes_gb(int(vm.used))
+            ram_available_gb = _format_bytes_gb(int(vm.available))
+            ram_total_gb = _format_bytes_gb(int(vm.total))
+        except Exception:
+            ram_usage_percent = ram_usage_gb = ram_available_gb = ram_total_gb = None
+        try:
+            process_memory_mb = round(float(psutil.Process().memory_info().rss) / (1024**2), 1)
+        except Exception:
+            process_memory_mb = None
+    else:
+        try:
+            import resource
+
+            rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
+            if py_platform.system().lower() == "darwin":
+                process_memory_mb = round(float(rss) / (1024 * 1024), 1)
+            else:
+                process_memory_mb = round(float(rss) / 1024, 1)
+        except Exception:
+            process_memory_mb = None
+
+        # Best-effort RAM metrics without psutil (Darwin fallback)
+        if py_platform.system().lower() == "darwin":
+            try:
+                total_bytes_raw = subprocess.check_output(["sysctl", "-n", "hw.memsize"], text=True).strip()
+                total_bytes = int(total_bytes_raw)
+
+                vm_stat_output = subprocess.check_output(["vm_stat"], text=True)
+                page_size = 4096
+                stats: Dict[str, int] = {}
+
+                for raw_line in vm_stat_output.splitlines():
+                    line = raw_line.strip()
+                    if not line:
+                        continue
+                    if "page size of" in line and "bytes" in line:
+                        try:
+                            page_size = int(line.split("page size of", 1)[1].split("bytes", 1)[0].strip())
+                        except Exception:
+                            page_size = 4096
+                        continue
+                    if ":" not in line:
+                        continue
+
+                    key_part, value_part = line.split(":", 1)
+                    key = key_part.strip().lower()
+                    digits = "".join(ch for ch in value_part if ch.isdigit())
+                    if not digits:
+                        continue
+                    stats[key] = int(digits)
+
+                free_pages = stats.get("pages free", 0) + stats.get("pages speculative", 0)
+                used_pages = (
+                    stats.get("pages active", 0)
+                    + stats.get("pages inactive", 0)
+                    + stats.get("pages wired down", 0)
+                    + stats.get("pages occupied by compressor", 0)
+                )
+
+                if total_bytes > 0:
+                    used_bytes = used_pages * page_size
+                    available_bytes = free_pages * page_size
+
+                    ram_total_gb = _format_bytes_gb(total_bytes)
+                    ram_usage_gb = _format_bytes_gb(used_bytes)
+                    ram_available_gb = _format_bytes_gb(available_bytes)
+                    ram_usage_percent = round((used_bytes / total_bytes) * 100, 1)
+            except Exception:
+                pass
+
+    load_per_core = load_average.get("perCore")
+    if disk_used_percent is None:
+        health = "degraded"
+    elif disk_used_percent >= 92:
+        health = "degraded"
+    elif load_per_core is not None and load_per_core >= 2.0:
+        health = "degraded"
+    else:
+        health = "healthy"
+
+    summary_parts = []
+    if load_per_core is not None:
+        summary_parts.append(f"Load {load_per_core:.2f}/core")
+    if cpu_usage_percent is not None:
+        summary_parts.append(f"CPU {cpu_usage_percent:.1f}%")
+    if ram_usage_percent is not None:
+        summary_parts.append(f"RAM {ram_usage_percent:.1f}%")
+    if disk_used_percent is not None:
+        summary_parts.append(f"Disk {disk_used_percent:.1f}%")
+    if process_memory_mb is not None:
+        summary_parts.append(f"RSS {process_memory_mb:.1f} MB")
+
+    return {
+        "health": health,
+        "host": host,
+        "platform": " ".join(part for part in [platform_name, platform_release] if part).strip(),
+        "platformVersion": platform_version,
+        "cpuCores": cpu_cores,
+        "cpuUsagePercent": cpu_usage_percent,
+        "ramUsage": {
+            "usedPercent": ram_usage_percent,
+            "usedGb": ram_usage_gb,
+            "availableGb": ram_available_gb,
+            "totalGb": ram_total_gb,
+        },
+        "loadAverage": load_average,
+        "diskUsage": {
+            "path": "~",
+            "usedPercent": disk_used_percent,
+            "freeGb": _format_bytes_gb(disk.free),
+            "totalGb": _format_bytes_gb(disk.total),
+        },
+        "processMemoryMb": process_memory_mb,
+        "summary": ", ".join(summary_parts) if summary_parts else "System metrics unavailable",
+    }
