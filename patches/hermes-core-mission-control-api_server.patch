+def _build_mission_control_sessions_payload() -> Dict[str, Any]:
+    from hermes_state import SessionDB
+
+    session_db = SessionDB()
+    try:
+        total_sessions = session_db.session_count()
+        total_messages = session_db.message_count()
+        start_of_day = datetime.now(timezone.utc).replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
+        with session_db._lock:
+            cursor = session_db._conn.execute(
+                "SELECT COALESCE(SUM(tool_call_count), 0) FROM sessions WHERE started_at >= ?",
+                (start_of_day,),
+            )
+            tool_calls_today = int(cursor.fetchone()[0] or 0)
+
+        recent_sessions = session_db.list_sessions_rich(limit=25)
+        active_cutoff = time.time() - (30 * 60)
+        active_agents = sum(
+            1
+            for session in recent_sessions
+            if session.get("ended_at") is None and float(session.get("last_active") or 0) >= active_cutoff
+        )
+
+        items = [
+            {
+                "id": session.get("id"),
+                "source": session.get("source") or "unknown",
+                "model": session.get("model") or "unknown",
+                "title": session.get("title") or session.get("preview") or session.get("id") or "Untitled session",
+                "startedAt": float(session.get("started_at") or session.get("startedAt") or 0),
+                "endedAt": session.get("ended_at"),
+                "messageCount": int(session.get("message_count") or session.get("messageCount") or 0),
+                "preview": session.get("preview") or "",
+                "lastActive": float(session.get("last_active") or session.get("lastActive") or 0),
+            }
+            for session in recent_sessions
+        ]
+
+        return {
+            "totalSessions": total_sessions,
+            "totalMessages": total_messages,
+            "activeAgents": active_agents,
+            "toolCallsToday": tool_calls_today,
+            "items": items,
+        }
+    finally:
+        session_db.close()
+
+
+def _safe_json_loads(value: Any) -> Any:
+    if isinstance(value, (dict, list)):
+        return value
+    if not isinstance(value, str):
+        return None
+    try:
+        return json.loads(value)
+    except Exception:
+        return None
+
+
+def _coerce_preview(value: Any, limit: int = 180) -> str:
+    text = str(value or "").strip()
+    if not text:
+        return ""
+    compact = " ".join(text.split())
+    if len(compact) <= limit:
+        return compact
+    return f"{compact[: max(0, limit - 1)]}…"
+
+
+def _coerce_trace_text(value: Any) -> str:
+    if value is None:
+        return ""
+    if isinstance(value, str):
+        return value
+    if isinstance(value, (dict, list)):
+        try:
+            return json.dumps(value, ensure_ascii=False, indent=2)
+        except Exception:
+            return str(value)
+    return str(value)
+
+
+def _build_mission_control_agent_trace_payload(session_id: str | None = None, limit: int = 300) -> Dict[str, Any]:
+    from hermes_state import SessionDB
+
+    session_db = SessionDB()
+    try:
+        recent_sessions = session_db.list_sessions_rich(limit=120)
+        selected: Dict[str, Any] | None = None
+
+        if session_id:
+            selected = next((item for item in recent_sessions if str(item.get("id") or "") == session_id), None)
+            if selected is None:
+                raise KeyError("session_not_found")
+        elif recent_sessions:
+            active_cutoff = time.time() - (30 * 60)
+            live_sessions = [
+                item
+                for item in recent_sessions
+                if item.get("ended_at") is None and float(item.get("last_active") or 0) >= active_cutoff
+            ]
+            selected = live_sessions[0] if live_sessions else recent_sessions[0]
+
+        if selected is None:
+            return {
+                "success": True,
+                "mode": "post",
+                "session": None,
+                "events": [],
+                "nodes": [],
+                "edges": [],
+                "stats": {
+                    "turns": 0,
+                    "toolCalls": 0,
+                    "skills": 0,
+                    "thoughts": 0,
+                    "errors": 0,
+                    "durationSeconds": 0,
+                },
+            }
+
+        selected_id = str(selected.get("id") or "")
+        messages = session_db.get_messages(selected_id)
+        if limit > 0 and len(messages) > limit:
+            messages = messages[-limit:]
+
+        events: List[Dict[str, Any]] = []
+        nodes: List[Dict[str, Any]] = []
+        edges: List[Dict[str, Any]] = []
+        pending_tool_calls: Dict[str, str] = {}
+        event_counter = 0
+        turn_id = 0
+        current_turn_event_id: str | None = None
+        current_turn_last_event_id: str | None = None
+        current_turn_started_at: float | None = None
+
+        def add_event(
+            *,
+            event_type: str,
+            label: str,
+            detail: str,
+            timestamp: float,
+            tone: str = "good",
+            status: str | None = None,
+            parent_event_id: str | None = None,
+            tool_name: str | None = None,
+            call_id: str | None = None,
+            skill_name: str | None = None,
+            request: str | None = None,
+            response: str | None = None,
+        ) -> str:
+            nonlocal event_counter, current_turn_last_event_id
+            event_counter += 1
+            event_id = f"evt-{event_counter}"
+
+            event_payload: Dict[str, Any] = {
+                "id": event_id,
+                "type": event_type,
+                "label": label,
+                "detail": detail,
+                "tone": tone,
+                "timestamp": timestamp,
+                "sessionId": selected_id,
+                "turnId": turn_id,
+            }
+            if status:
+                event_payload["status"] = status
+            if parent_event_id:
+                event_payload["parentEventId"] = parent_event_id
+            if tool_name:
+                event_payload["toolName"] = tool_name
+            if call_id:
+                event_payload["callId"] = call_id
+            if skill_name:
+                event_payload["skillName"] = skill_name
+            if request:
+                event_payload["request"] = request
+            if response:
+                event_payload["response"] = response
+
+            events.append(event_payload)
+            nodes.append(
+                {
+                    "id": event_id,
+                    "kind": event_type,
+                    "label": label,
+                    "status": status or "ok",
+                    "turnId": turn_id,
+                    "timestamp": timestamp,
+                }
+            )
+
+            if parent_event_id:
+                edges.append({"from": parent_event_id, "to": event_id, "kind": "parent"})
+            elif current_turn_last_event_id and current_turn_last_event_id != event_id:
+                edges.append({"from": current_turn_last_event_id, "to": event_id, "kind": "sequence"})
+
+            current_turn_last_event_id = event_id
+            return event_id
+
+        for raw in messages:
+            role = str(raw.get("role") or "")
+            timestamp = float(raw.get("timestamp") or selected.get("started_at") or time.time())
+
+            if role == "user":
+                if turn_id > 0 and current_turn_event_id:
+                    add_event(
+                        event_type="turn_completed",
+                        label=f"Turn {turn_id} completed",
+                        detail="Agent finished this turn.",
+                        timestamp=timestamp,
+                        tone="good",
+                        status="completed",
+                        parent_event_id=current_turn_event_id,
+                    )
+
+                turn_id += 1
+                current_turn_started_at = timestamp
+                current_turn_last_event_id = None
+                current_turn_event_id = add_event(
+                    event_type="turn_started",
+                    label=f"Turn {turn_id}",
+                    detail=_coerce_trace_text(raw.get("content") or "User input") or "User input",
+                    timestamp=timestamp,
+                    tone="good",
+                    status="running",
+                )
+                continue
+
+            if turn_id == 0:
+                turn_id = 1
+                current_turn_started_at = float(selected.get("started_at") or timestamp)
+                current_turn_last_event_id = None
+                current_turn_event_id = add_event(
+                    event_type="turn_started",
+                    label="Turn 1",
+                    detail="Recovered turn boundary from session history.",
+                    timestamp=current_turn_started_at,
+                    tone="warn",
+                    status="recovered",
+                )
+
+            if role == "assistant":
+                reasoning = _coerce_trace_text(raw.get("reasoning"))
+                if reasoning:
+                    add_event(
+                        event_type="thought",
+                        label="Reasoning",
+                        detail=reasoning,
+                        timestamp=timestamp,
+                        tone="good",
+                        parent_event_id=current_turn_event_id,
+                    )
+
+                tool_calls = raw.get("tool_calls")
+                if isinstance(tool_calls, str):
+                    tool_calls = _safe_json_loads(tool_calls)
+                if not isinstance(tool_calls, list):
+                    tool_calls = []
+
+                if tool_calls:
+                    for tool_call in tool_calls:
+                        if not isinstance(tool_call, dict):
+                            continue
+                        function = tool_call.get("function") if isinstance(tool_call.get("function"), dict) else {}
+                        tool_name = str(function.get("name") or "tool")
+                        call_id = str(tool_call.get("id") or "")
+                        raw_args = function.get("arguments")
+                        args_payload = _safe_json_loads(raw_args) if isinstance(raw_args, str) else raw_args
+                        request_payload = _coerce_trace_text(raw_args if raw_args is not None else args_payload)
+
+                        start_event_id = add_event(
+                            event_type="tool_call_started",
+                            label=f"Tool call · {tool_name}",
+                            detail=request_payload or "Tool call started",
+                            timestamp=timestamp,
+                            tone="good",
+                            status="running",
+                            parent_event_id=current_turn_event_id,
+                            tool_name=tool_name,
+                            call_id=call_id,
+                            request=request_payload or None,
+                        )
+                        if call_id:
+                            pending_tool_calls[call_id] = start_event_id
+
+                        if tool_name in {"skill_view", "skills_list", "skill_manage"}:
+                            inferred_skill = ""
+                            if isinstance(args_payload, dict):
+                                inferred_skill = str(args_payload.get("name") or args_payload.get("skill") or "").strip()
+                            add_event(
+                                event_type="skill_used",
+                                label=f"Skill {'· ' + inferred_skill if inferred_skill else 'tool'}",
+                                detail=f"Triggered via {tool_name}.",
+                                timestamp=timestamp,
+                                tone="good",
+                                status="applied",
+                                parent_event_id=start_event_id,
+                                tool_name=tool_name,
+                                call_id=call_id,
+                                skill_name=inferred_skill or None,
+                            )
+                else:
+                    response_text = _coerce_trace_text(raw.get("content"))
+                    if response_text:
+                        add_event(
+                            event_type="assistant_response",
+                            label="Assistant response",
+                            detail=response_text,
+                            timestamp=timestamp,
+                            tone="good",
+                            status="completed",
+                            parent_event_id=current_turn_event_id,
+                        )
+                continue
+
+            if role == "tool":
+                tool_name = str(raw.get("tool_name") or "tool")
+                call_id = str(raw.get("tool_call_id") or "")
+                parent_event_id = pending_tool_calls.get(call_id) or current_turn_event_id
+                request_text = _coerce_trace_text(raw.get("tool_request"))
+                output_text = _coerce_trace_text(raw.get("tool_response")) or _coerce_trace_text(raw.get("content")) or "Tool output received"
+                lowered = output_text.lower()
+                is_error = any(token in lowered for token in ("error", "exception", "traceback"))
+                add_event(
+                    event_type="tool_call_completed",
+                    label=f"Tool output · {tool_name}",
+                    detail=output_text,
+                    timestamp=timestamp,
+                    tone="bad" if is_error else "good",
+                    status="failed" if is_error else "completed",
+                    parent_event_id=parent_event_id,
+                    tool_name=tool_name,
+                    call_id=call_id or None,
+                    request=request_text or None,
+                    response=output_text,
+                )
+                if call_id and call_id in pending_tool_calls:
+                    pending_tool_calls.pop(call_id, None)
+
+        if turn_id > 0 and current_turn_event_id:
+            last_ts = float(messages[-1].get("timestamp") or selected.get("last_active") or time.time()) if messages else time.time()
+            add_event(
+                event_type="turn_completed",
+                label=f"Turn {turn_id} completed",
+                detail="Latest known turn boundary.",
+                timestamp=last_ts,
+                tone="good",
+                status="completed",
+                parent_event_id=current_turn_event_id,
+            )
+
+        turns_count = len([event for event in events if event.get("type") == "turn_started"])
+        tool_calls_count = len([event for event in events if event.get("type") == "tool_call_started"])
+        skills_count = len([event for event in events if event.get("type") == "skill_used"])
+        thoughts_count = len([event for event in events if event.get("type") == "thought"])
+        errors_count = len([event for event in events if event.get("status") == "failed"])
+
+        started_at = float(selected.get("started_at") or 0)
+        last_active = float(selected.get("last_active") or started_at or time.time())
+        duration_seconds = max(0, int(last_active - started_at)) if started_at else 0
+        is_live = selected.get("ended_at") is None and (time.time() - last_active) < (30 * 60)
+
+        return {
+            "success": True,
+            "mode": "live" if is_live else "post",
+            "session": {
+                "id": selected_id,
+                "source": selected.get("source") or "unknown",
+                "model": selected.get("model") or "unknown",
+                "title": selected.get("title") or selected.get("preview") or selected_id,
+                "startedAt": started_at,
+                "endedAt": selected.get("ended_at"),
+                "messageCount": int(selected.get("message_count") or 0),
+                "lastActive": last_active,
+            },
+            "events": events,
+            "nodes": nodes,
+            "edges": edges,
+            "stats": {
+                "turns": turns_count,
+                "toolCalls": tool_calls_count,
+                "skills": skills_count,
+                "thoughts": thoughts_count,
+                "errors": errors_count,
+                "durationSeconds": duration_seconds,
+            },
+        }
+    finally:
+        session_db.close()
+
+
+def _build_mission_control_cron_payload() -> Dict[str, Any]:
+    try:
+        from cron.jobs import list_jobs as _cron_list
+
+        jobs = _cron_list(include_disabled=True)
+    except Exception:
+        jobs = []
+
+    items = []
+    for job in jobs:
+        skills = job.get("skills") or []
+        if isinstance(skills, str):
+            skills = [skills]
+
+        items.append(
+            {
+                "id": job.get("id"),
+                "label": job.get("label") or job.get("name") or job.get("schedule_display") or job.get("id") or "Scheduled job",
+                "enabled": bool(job.get("enabled", True)),
+                "state": job.get("state") or ("scheduled" if job.get("enabled", True) else "paused"),
+                "scheduleDisplay": job.get("schedule_display") or job.get("scheduleDisplay") or "unspecified",
+                "nextRunAt": job.get("next_run_at") or job.get("nextRunAt"),
+                "lastRunAt": job.get("last_run_at") or job.get("lastRunAt"),
+                "pausedReason": job.get("paused_reason") or job.get("pausedReason"),
+                "lastStatus": job.get("last_status") or job.get("lastStatus"),
+                "lastError": job.get("last_error") or job.get("lastError"),
+                "prompt": job.get("prompt") or "",
+                "model": job.get("model") or "unknown",
+                "provider": job.get("provider") or None,
+                "skill": job.get("skill") or None,
+                "skills": skills,
+            }
+        )
+
+    return {"queuedJobs": sum(1 for job in items if job["enabled"]), "items": items}
+
