+def _load_knowledge_sharing_note() -> Dict[str, Any]:
+    hermes_home = Path.home() / ".hermes"
+    memories_dir = hermes_home / "memories"
+    vault = Path(os.getenv("OBSIDIAN_VAULT_PATH") or (Path.home() / "Documents" / "Hermes"))
+
+    core_specs: List[Dict[str, Any]] = [
+        {"title": "MEMORY.md", "candidates": [memories_dir / "MEMORY.md", hermes_home / "MEMORY.md"]},
+        {"title": "USER.md", "candidates": [hermes_home / "USER.md", memories_dir / "USER.md"]},
+        {"title": "IDENTITY.md", "candidates": [memories_dir / "IDENTITY.md", hermes_home / "IDENTITY.md"]},
+        {"title": "AGENTS.md", "candidates": [hermes_home / "AGENTS.md"]},
+        {"title": "SOUL.md", "candidates": [hermes_home / "SOUL.md"]},
+    ]
+
+    def _missing_entry(title: str, preferred_path: Path) -> Dict[str, Any]:
+        redacted = _redact_home_path(str(preferred_path))
+        return {
+            "id": title.lower(),
+            "title": title,
+            "path": redacted,
+            "sourcePath": redacted,
+            "updatedAt": None,
+            "excerpt": f"Create {title} to surface it here.",
+            "highlights": [],
+            "contentPreview": "",
+        }
+
+    def _resolve_core_entry(title: str, candidates: List[Path]) -> Dict[str, Any]:
+        existing = next((candidate for candidate in candidates if candidate.is_file()), None)
+        if existing is None:
+            return _missing_entry(title, candidates[0])
+
+        entry = _build_vault_note_entry(existing, hermes_home)
+        entry["id"] = title.lower()
+        entry["title"] = title
+        entry["path"] = _redact_home_path(str(existing))
+        return entry
+
+    core_items = [_resolve_core_entry(spec["title"], spec["candidates"]) for spec in core_specs]
+
+    try:
+        vault_notes = [path for path in vault.rglob("*.md") if path.is_file()]
+        vault_notes.sort(key=lambda path: path.stat().st_mtime if path.exists() else 0, reverse=True)
+    except Exception:
+        vault_notes = []
+
+    vault_items = [_build_vault_note_entry(note_path, vault) for note_path in vault_notes]
+    core_source_paths = {str(item.get("sourcePath") or "").lower() for item in core_items}
+    vault_items = [item for item in vault_items if str(item.get("sourcePath") or "").lower() not in core_source_paths]
+
+    primary_entry = next((item for item in core_items if item.get("title") == "SOUL.md" and item.get("updatedAt")), None)
+    if primary_entry is None:
+        primary_entry = next((item for item in core_items if item.get("updatedAt")), None)
+    if primary_entry is None and vault_items:
+        primary_entry = vault_items[0]
+    if primary_entry is None:
+        primary_entry = _missing_entry("SOUL.md", hermes_home / "SOUL.md")
+
+    items: List[Dict[str, Any]] = []
+    seen_ids: set[str] = set()
+    for entry in [*core_items, *vault_items]:
+        entry_id = str(entry.get("id") or "")
+        if not entry_id or entry_id in seen_ids:
+            continue
+        seen_ids.add(entry_id)
+        items.append(entry)
+
+    available = any(bool(item.get("updatedAt")) for item in core_items) or bool(vault_items)
+
+    return {
+        "available": available,
+        "vaultPath": _redact_home_path(str(hermes_home)),
+        "title": primary_entry["title"],
+        "path": primary_entry["path"],
+        "updatedAt": primary_entry["updatedAt"],
+        "excerpt": primary_entry["excerpt"],
+        "highlights": primary_entry["highlights"],
+        "primary": primary_entry,
+        "items": items,
+        "sections": [
+            {
+                "id": "hermes-core",
+                "title": "Hermes memory",
+                "items": core_items,
+            },
+            {
+                "id": "vault-notes",
+                "title": "Obsidian vault",
+                "items": vault_items,
+            },
+        ],
+    }
